# Copy to .env for local development. On Render, set these in Environment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET=replace-with-a-long-random-string
OFFICER_EMAIL=admin@example.com
OFFICER_PASSWORD=change-me

# Local http testing only. Leave unset (true) in production.
COOKIE_SECURE=false

# Optional
# DEMO_VEHICLE_CODE=V1
# DEMO_VEHICLE_NO=KA 01 AB 1234
# ALLOW_ORIGINS=http://localhost:5173
